{
  "name": "clc-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vocs dev",
    "build": "vocs build && node scripts/finalize_multilingual_build.mjs",
    "check:i18n": "node scripts/check_locales.mjs",
    "i18n:headings": "node scripts/build_heading_map.mjs",
    "i18n:headings:check": "node scripts/build_heading_map.mjs --check",
    "i18n:manifest": "node scripts/refresh_translation_manifest.mjs fr && node scripts/refresh_translation_manifest.mjs es && node scripts/refresh_translation_manifest.mjs pt",
    "i18n:protected": "node scripts/synchronize_protected_content.mjs",
    "i18n:catalogs": "node scripts/synchronize_locale_catalogs.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vocs preview",
    "whitepaper:tex": "python3 scripts/build_white_paper_tex.py",
    "whitepaper:pdf": "python3 scripts/build_white_paper_tex.py --all && python3 scripts/build_white_paper_pdfs.py",
    "whitepaper:publish": "npm run whitepaper:pdf"
  },
  "dependencies": {
    "mermaid": "^11.12.2",
    "minisearch": "7.2.0",
    "react": "latest",
    "react-dom": "latest",
    "vocs": "1.4.1"
  },
  "devDependencies": {
    "@types/react": "latest",
    "typescript": "latest"
  }
}
